#!name=Apple TV F1 中文字幕（Raw Manifest Test）
#!desc=纯 F1 回放诊断版：沿用旧版规则，仅将 Manifest 脚本改为固定 raw 地址；不包含电影。

[MITM]
hostname = %APPEND% hls-amt.itunes.apple.com

[Script]
f1-subtitle-manifest = type=http-response,pattern=^https?:\/\/hls-amt\.itunes\.apple\.com\/itunes-assets\/HLSSportsVodVideo\d+\/v4\/.+\/.+_subtitles_V\d+\.m3u8,requires-body=1,script-path=https://raw.githubusercontent.com/rexchen1803/apple-video-subtitles/8118f3f/payloads/DualSubs-Universal-v1.7.5.Manifest.response.bundle.js
apple-tv-f1-chinese = type=http-response,pattern=^https?:\/\/hls-amt\.itunes\.apple\.com\/itunes-assets\/HLSSportsVodVideo\d+\/v4\/(?:[^\/]+\/)+(?:P1337486392_A1881724926|P1337522687_A1881777941|P1326620577_A1881763666|P1364568578_A1881733891|P1392837560_A1881753363|P1411825097_A1881742204|P1413846083_A1881690171|P1429344944_A1882150267|P1436852938_A1881739464|P1457248952_A1881786635)_en_subtitles_V2-\d+\.webvtt(?:\?.*)?$,requires-body=1,script-path=https://raw.githubusercontent.com/rexchen1803/apple-tv-f1-subtitles/main/payloads/2026-f1-race-commentary-zh.js

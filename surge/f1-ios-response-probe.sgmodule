#!name=Apple TV F1 手机脚本探针
#!desc=仅用于判断 Surge iOS 是否能执行 F1 字幕响应脚本；不会注入中文轨，测试后请停用。

[MITM]
hostname = %APPEND% hls-amt.itunes.apple.com

[Script]
F1.iOS.ResponseProbe = type=http-response,pattern=^https?:\/\/hls-amt\.itunes\.apple\.com\/itunes-assets\/HLSSportsVodVideo\d+\/v4\/.+\/.+_en_subtitles_V2-\d+\.webvtt(?:\?.*)?$,requires-body=1,max-size=2097152,timeout=30,script-path=https://raw.githubusercontent.com/rexchen1803/apple-video-subtitles/f6ec181/payloads/diagnostics/f1-ios-response-probe.js

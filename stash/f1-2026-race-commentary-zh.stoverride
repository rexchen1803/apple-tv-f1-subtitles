name: Apple TV F1 中文字幕（Public Beta）
desc: 2026.07.31.1｜2026 F1 前 10 站正赛回放，英文解说字幕替换为中文；需开启 MITM 并信任证书

http:
  mitm:
    - hls-amt.itunes.apple.com
  script:
    - match: '^https?:\/\/hls-amt\.itunes\.apple\.com\/itunes-assets\/HLSSportsVodVideo\d+\/v4\/.+\/.+_subtitles_V\d+\.m3u8'
      name: f1-subtitle-manifest
      type: response
      require-body: true
    - match: '^https?:\/\/hls-amt\.itunes\.apple\.com\/itunes-assets\/HLSSportsVodVideo\d+\/v4\/(?:[^\/]+\/)+(?:P1337486392_A1881724926|P1337522687_A1881777941|P1326620577_A1881763666|P1364568578_A1881733891|P1392837560_A1881753363|P1411825097_A1881742204|P1413846083_A1881690171|P1429344944_A1882150267|P1436852938_A1881739464|P1457248952_A1881786635)_en_subtitles_V2-\d+\.webvtt(?:\?.*)?$'
      name: apple-tv-f1-chinese
      type: response
      require-body: true

script-providers:
  f1-subtitle-manifest:
    url: https://github.com/DualSubs/Universal/releases/download/v1.7.5/Manifest.response.bundle.js
    interval: 86400
  apple-tv-f1-chinese:
    url: https://raw.githubusercontent.com/rexchen1803/apple-tv-f1-subtitles/main/payloads/2026-f1-race-commentary-zh.js
    interval: 86400

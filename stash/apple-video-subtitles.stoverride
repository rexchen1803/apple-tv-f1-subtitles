name: Apple TV 中文字幕（F1 + 影片）
desc: 2026 F1 前 10 站正赛回放中文字幕；另含《火星救援》《碟中谍4》《泰坦尼克号》《消失的爱人》中文字幕，以及《星际穿越》法语字幕轨替换为简体中文；需开启 MITM 并信任证书。

http:
  mitm:
    - hls-amt.itunes.apple.com
    - uts-api.itunes.apple.com
    - play-cdn.itunes.apple.com
    - play-edge-cdn.itunes.apple.com
    - vod-ap-aoc.tv.apple.com
    - vod-fa-aoc.tv.apple.com
    - vod-ak-aoc.tv.apple.com
    - vod-ap-amt.tv.apple.com
    - vod-fa-amt.tv.apple.com
    - vod-ak-amt.tv.apple.com
  url-rewrite:
    - ^https?:\/\/play-cdn\.itunes\.apple\.com https://play.itunes.apple.com transparent
    - ^https?:\/\/play-edge-cdn\.itunes\.apple\.com https://play-edge.itunes.apple.com transparent
  script:
    - match: '^https?:\/\/uts-api\.itunes\.apple\.com\/uts\/(?:v1|v2|v3)\/'
      name: apple-tv-playback-host-workaround
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https?:\/\/hls-amt\.itunes\.apple\.com\/itunes-assets\/HLSSportsVodVideo\d+\/v4\/.+\/.+_subtitles_V\d+\.m3u8'
      name: f1-subtitle-manifest
      type: response
      require-body: true
    - match: '^https?:\/\/hls-amt\.itunes\.apple\.com\/itunes-assets\/HLSSportsVodVideo\d+\/v4\/(?:[^\/]+\/)+(?:P1337486392_A1881724926|P1337522687_A1881777941|P1326620577_A1881763666|P1364568578_A1881733891|P1392837560_A1881753363|P1411825097_A1881742204|P1413846083_A1881690171|P1429344944_A1882150267|P1436852938_A1881739464|P1457248952_A1881786635)_en_subtitles_V2-\d+\.webvtt(?:\?.*)?$'
      name: f1-race-commentary-zh
      type: response
      require-body: true
    - match: '^https?:\/\/hls-amt\.itunes\.apple\.com\/itunes-assets\/HLSSportsVodVideo\d+\/v4\/(?:[^\/]+\/)+(?:P1337486392_A1881724926|P1337522687_A1881777941|P1326620577_A1881763666|P1364568578_A1881733891|P1392837560_A1881753363|P1411825097_A1881742204|P1413846083_A1881690171|P1429344944_A1882150267|P1436852938_A1881739464|P1457248952_A1881786635)_es_subtitles_V2-\d+\.webvtt(?:\?.*)?$'
      name: f1-race-commentary-fan-zh
      type: response
      require-body: true
    - match: '^https:\/\/play-edge(?:-cdn)?\.itunes\.apple\.com\/WebObjects\/MZPlayLocal\.woa\/hls\/subscription\/playlist\.m3u8\?(?:.*&)?a=6799243858(?:&.*)?$'
      name: movie-the-martian-manifest
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/play-edge(?:-cdn)?\.itunes\.apple\.com\/WebObjects\/MZPlayLocal\.woa\/hls\/subscription\/stream\/playlist\.m3u8\?[^#]*mainAssetAdamId=6799243858[^#]*martianzh=1[^#]*$'
      name: movie-the-martian-playlist
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/vod-(?:ap|fa|ak)-aoc\.tv\.apple\.com\/itunes-assets\/(?:[^\/]+\/)+P1468742269_A6799243858_en_subtitles_V\d+-\.webvtt\?[^#]*martianzh=1[^#]*$'
      name: movie-the-martian-vtt
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/play-edge(?:-cdn)?\.itunes\.apple\.com\/WebObjects\/MZPlayLocal\.woa\/hls\/subscription\/playlist\.m3u8\?(?:.*&)?a=6793326577(?:&.*)?$'
      name: movie-mi4-manifest
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/play-edge(?:-cdn)?\.itunes\.apple\.com\/WebObjects\/MZPlayLocal\.woa\/hls\/subscription\/stream\/playlist\.m3u8\?[^#]*mainAssetAdamId=6793326577[^#]*mi4zhadd=1[^#]*$'
      name: movie-mi4-playlist
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/vod-(?:ap|fa|ak)-aoc\.tv\.apple\.com\/itunes-assets\/(?:[^\/]+\/)+P1467262841_A6793326577_es-419_subtitles_V\d+-\.webvtt\?[^#]*mi4zhadd=1[^#]*$'
      name: movie-mi4-vtt
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/play-edge(?:-cdn)?\.itunes\.apple\.com\/WebObjects\/MZPlayLocal\.woa\/hls\/subscription\/playlist\.m3u8\?(?:.*&)?a=6793332306(?:&.*)?$'
      name: movie-titanic-manifest
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/play-edge(?:-cdn)?\.itunes\.apple\.com\/WebObjects\/MZPlayLocal\.woa\/hls\/subscription\/stream\/playlist\.m3u8\?[^#]*mainAssetAdamId=6793332306[^#]*titaniczh=1[^#]*$'
      name: movie-titanic-playlist
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/vod-(?:ap|fa|ak)-aoc\.tv\.apple\.com\/itunes-assets\/HLSAppleVideo221\/v4\/59\/aa\/9d\/59aa9ddd-f65a-085f-7a2c-c4b927941f8b\/empty-11688089\.webvtt\?[^#]*titaniczh=1[^#]*$'
      name: movie-titanic-vtt
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/play-edge(?:-cdn)?\.itunes\.apple\.com\/WebObjects\/MZPlayLocal\.woa\/hls\/subscription\/playlist\.m3u8\?(?:.*&)?a=6792938265(?:&.*)?$'
      name: movie-gone-girl-manifest
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/play-edge(?:-cdn)?\.itunes\.apple\.com\/WebObjects\/MZPlayLocal\.woa\/hls\/subscription\/stream\/playlist\.m3u8\?[^#]*mainAssetAdamId=6792938265[^#]*gonegirlzh=1[^#]*$'
      name: movie-gone-girl-playlist
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/vod-(?:ap|fa|ak)-aoc\.tv\.apple\.com\/itunes-assets\/(?:[^\/]+\/)+P1467262512_A6792938265_en_subtitles_V\d+-\.webvtt\?[^#]*gonegirlzh=1[^#]*$'
      name: movie-gone-girl-vtt
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
    - match: '^https:\/\/vod-(?:ap|fa|ak)-amt\.tv\.apple\.com\/itunes-assets\/(?:[^\/]+\/)+P1220541004_A960891136_fr-FR_subtitles_V2-\d+\.webvtt(?:\?.*)?$'
      name: movie-interstellar-vtt
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152

